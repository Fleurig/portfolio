# Auth
BETTER_AUTH_SECRET=change_me_to_a_random_32_char_string
BETTER_AUTH_URL=http://localhost:3000

# The email address that gets auto-promoted to admin on first login
ADMIN_EMAIL=your@email.com

# SQLite database path (default: ./portfolio.db)
DATABASE_PATH=./portfolio.db

# Public URL used in emails etc.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Show admin link in footer (set to "true" in staging/prod if needed)
# In development mode the link is always visible
NEXT_PUBLIC_SHOW_ADMIN=false
